# ─── URL publique ─────────────────────────────────────────────────────
# Utilisée pour construire les liens absolus dans les emails (magic link, etc).
PUBLIC_BASE_URL=http://localhost:3000

# ─── SMTP (envoi d'emails transactionnels) ────────────────────────────
# Tout serveur SMTP standard est compatible. Recommandation :
#  - Postfix self-hosted (le plus indépendant)
#  - Mailcow / Mail-in-a-Box auto-hébergés
#  - OVHcloud, Infomaniak, Mailjet, Brevo (UE)
#
# Si SMTP_HOST n'est pas défini, l'application bascule en mode "outbox"
# et écrit les emails dans data/outbox/ au format .eml (consultable
# depuis /mairie/emails). Pratique en dev/CI.

# SMTP_HOST=smtp.example.fr
# SMTP_PORT=587
# SMTP_SECURE=false           # true uniquement pour SMTPS (port 465)
# SMTP_REQUIRE_TLS=true       # STARTTLS obligatoire (recommandé)
# SMTP_USER=trizac@example.fr
# SMTP_PASS=changeme
# EMAIL_FROM=Trizac <noreply@trizac.fr>
