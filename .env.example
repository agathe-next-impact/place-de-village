# ─── URL publique ─────────────────────────────────────────────────────
# Utilisée pour construire les liens absolus dans les emails (magic link, etc).
PUBLIC_BASE_URL=http://localhost:3000

# ─── SMTP (envoi d'emails transactionnels) ────────────────────────────
# Tout serveur SMTP standard est compatible. Recommandation :
#  - Postfix self-hosted (le plus indépendant)
#  - Mailcow / Mail-in-a-Box auto-hébergés
#  - OVHcloud, Infomaniak, Mailjet, Brevo (UE)
#
# Si SMTP_HOST n'est pas défini, l'application bascule en mode "outbox"
# et écrit les emails dans data/outbox/ au format .eml (consultable
# depuis /mairie/emails). Pratique en dev/CI.

# SMTP_HOST=smtp.example.fr
# SMTP_PORT=587
# SMTP_SECURE=false           # true uniquement pour SMTPS (port 465)
# SMTP_REQUIRE_TLS=true       # STARTTLS obligatoire (recommandé)
# SMTP_USER=trizac@example.fr
# SMTP_PASS=changeme
# EMAIL_FROM=Trizac <noreply@trizac.fr>

# ─── SMS (rappel J-1 mission de bénévolat) ────────────────────────────
# Provider interchangeable. "outbox" écrit dans data/sms-outbox/ et
# n'envoie aucun SMS réel — pratique en dev/CI.
#
# Providers fournis :
#   outbox     (par défaut, démo)
#   smspartner (France, RGPD, simple HTTP REST)
#   ovh-sms    (France, cloud souverain — implémentation HMAC à compléter)

# SMS_PROVIDER=smspartner
# SMSPARTNER_API_KEY=xxxxxxxxxxxxxxxx
# SMSPARTNER_SENDER=Trizac          # 11 caractères max, alphanum sans accent

# Cron SMS — secret partagé pour POST /api/cron/sms (cron infra)
# CRON_SECRET=changeme

# ─── Suivi d'erreurs (Sentry self-hosted ou GlitchTip) ────────────────
# Le SDK @sentry/nextjs est compatible avec :
#   - Sentry self-hosted (Docker Compose, https://develop.sentry.dev/self-hosted/)
#   - GlitchTip (alternative légère 100% open-source, https://glitchtip.com/)
#   - Sentry SaaS (option commerciale)
#
# Sans DSN défini, la capture d'erreurs reste locale (table error_log
# + console + page /mairie/errors). Aucun appel réseau émis.

# SENTRY_DSN=https://<key>@sentry.example.fr/<project>             # côté serveur
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@sentry.example.fr/<project> # côté navigateur (peut être identique)
# SENTRY_RELEASE=trizac@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.1                                    # 10% par défaut

# ─── Analytics (Plausible auto-hébergé, sans cookies) ─────────────────
# Plausible est open source (AGPL), 100% self-hosted via Docker Compose,
# sans cookies ni profilage individuel — conforme RGPD par construction
# (pas de bandeau de consentement requis pour la mesure d'audience).
#
# Sans configuration, aucun script n'est chargé sur les pages.

# NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.example.fr
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=trizac.fr
